# ---- Network ---------------------------------------------------------------
# "testnet" (default) or "mainnet". Anything else falls back to testnet.
VITE_HL_NETWORK=testnet

# ---- Privy (https://dashboard.privy.io) -----------------------------------
# App ID is public by design. NEVER put the Privy *app secret* in the frontend.
VITE_PRIVY_APP_ID=

# ---- Supabase (optional: profiles only, no keys/funds) ---------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Builder fees (OFF unless BOTH are set and valid) ----------------------
# Builder address that receives the fee, and the fee in tenths of a basis point
# (1 = 0.1 bps = 0.001%). Hyperliquid caps perps at 100 (0.1%).
VITE_BUILDER_ADDRESS=
VITE_BUILDER_FEE=

# ---- HIP-3 markets ---------------------------------------------------------
# Comma-separated HIP-3 dex names to list (trade[XYZ] is "xyz").
VITE_HIP3_DEXS=xyz

# ---- Geoblocking (you decide the list; nothing is hardcoded) ---------------
# ISO-3166 alpha-2 codes, comma-separated. Empty = no blocking.
VITE_GEOBLOCK_COUNTRIES=
# "true" blocks trading when the country can't be determined.
VITE_GEOBLOCK_FAIL_CLOSED=false
